{
  "@context": {
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "description": {
      "@id": "https://schema.org/description",
      "@container": "@language"
    }
  },
  "@id": "https://raw.githubusercontent.com/Prometheus-X-association/reference-models/main/src/references/rules/rule-responsibility-6.json",
  "title": {
    "@type": "xsd/string",
    "@value": "Non-Participation Clause"
  },
  "uid": "rule-responsibility-6",
  "name": "Non-Participation Clause",
  "description": [
    {
      "@value": "CAN NOT be service or data provider or end user",
      "@language": "en"
    },
    {
      "@value": "NE PEUT PAS être un fournisseur de services ou de données ou un utilisateur final",
      "@language": "fr"
    }
  ],
  "policy": {
    "permission": [
      {
        "action": "join",
        "target": "@{target}",
        "constraint": [
          {
            "leftOperand": "role",
            "operator": "in",
            "rightOperand": ["service", "dataProvider", "endUser"]
          }
        ]
      }
    ]
  },
  "requestedFields": ["target"]
}
