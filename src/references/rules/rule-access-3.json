{
  "@context": {
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "description": {
      "@id": "https://schema.org/description",
      "@container": "@language"
    }
  },
  "@id": "https://raw.githubusercontent.com/Prometheus-X-association/reference-models/main/src/references/rules/rule-access-3.json",
  "title": {
    "@type": "xsd/string",
    "@value": "Time Period"
  },
  "uid": "rule-access-3",
  "name": "Time Period",
  "description": [
    {
      "@value": "MUST use data for a specified time period",
      "@language": "en"
    },
    {
      "@value": "DOIT utiliser les données pour une période de temps spécifiée",
      "@language": "fr"
    }
  ],
  "policy": {
    "permission": [
      {
        "action": "use",
        "target": "@{target}",
        "constraint": [
          {
            "leftOperand": "dateTime",
            "operator": "gteq",
            "rightOperand": "@{dateBegin}"
          },
          {
            "leftOperand": "dateTime",
            "operator": "lteq",
            "rightOperand": "@{dateEnd}"
          }
        ]
      }
    ]
  },
  "requestedFields": ["target", "dateBegin", "dateEnd"]
}
