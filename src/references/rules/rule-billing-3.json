{
  "@context": {
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "description": {
      "@id": "https://schema.org/description",
      "@container": "@language"
    }
  },
  "@id": "https://raw.githubusercontent.com/Prometheus-X-association/reference-models/main/src/references/rules/rule-billing-3.json",
  "title": {
    "@type": "xsd/string",
    "@value": "Usage Count Subscription"
  },
  "uid": "rule-billing-3",
  "name": "Usage Count Subscription",
  "description": [
    {
      "@value": "MUST verify that the remaining usage count is greater than zero and decrement it before granting usage permission.",
      "@language": "en"
    },
    {
      "@value": "DOIT vérifier que le nombre d'utilisations restantes est supérieur à zéro et le décrémenter avant d'accorder la permission d'utilisation.",
      "@language": "fr"
    }
  ],
  "policy": {
    "permission": [
      {
        "target": "@{target}",
        "action": "use",
        "duty": [
          {
            "action": "extract",
            "constraint": [
              {
                "leftOperand": "usageCount",
                "operator": "gt",
                "rightOperand": 0
              }
            ]
          }
        ]
      }
    ]
  },
  "requestedFields": ["target"]
}
