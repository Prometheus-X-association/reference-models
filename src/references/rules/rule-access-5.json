{
  "@context": {
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "description": {
      "@id": "https://schema.org/description",
      "@container": "@language"
    }
  },
  "@id": "https://raw.githubusercontent.com/Prometheus-X-association/reference-models/main/src/references/rules/rule-access-5.json",
  "title": {
    "@type": "xsd/string",
    "@value": "Within a time interval"
  },
  "uid": "rule-access-5",
  "name": "Within a time interval",
  "description": [
    {
      "@value": "MUST use data within a specified time interval and MUST delete the data at the specified time stamp",
      "@language": "en"
    },
    {
      "@value": "DOIT utiliser les données dans un intervalle de temps spécifié et DOIT supprimer les données à l'horodatage spécifié",
      "@language": "fr"
    }
  ],
  "policy": {
    "permission": [
      {
        "action": "use",
        "target": "@{target}",
        "constraint": [
          {
            "leftOperand": "dateTime",
            "operator": "gteq",
            "rightOperand": "@{dateBegin}"
          },
          {
            "leftOperand": "dateTime",
            "operator": "lteq",
            "rightOperand": "@{dateEnd}"
          }
        ]
      }
    ]
  },
  "requestedFields": ["target", "dateBegin", "dateEnd"]
}
